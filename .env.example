# Copy this file to .env and fill in your deployed Cloudflare Worker URL
# and your Firebase project's web config.
# All values here are public (embedded in the app bundle) — none of these
# are secrets. Real secrets (the Gemini API key, the refresh secret) live
# only in Cloudflare via `wrangler secret put` — see
# cloudflare-worker/README.md.

EXPO_PUBLIC_WORKER_URL=https://nutrimate-live.your-subdomain.workers.dev

# From Firebase Console → Project settings → General → Your apps → SDK config
# See /FIRESTORE-SETUP.md for the full one-time setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
